(executable
 (name main)
 (public_name quiver)
 (libraries
  cmdliner
  base
  stdio
  angstrom
  hex_encode
  quiver.core
  quiver.sink
  quiver.mysql
  quiver.load
  quiver.net
  quiver.quiverfile
  quiver.docs
  file_path)
 (link_flags (:standard -ocamlrunparam d=512))
 (preprocess
  (pps ppx_let ppx_sexp_conv)))

(rule
 (target version.ml)
 (action
  (with-stdout-to
   %{target}
   (echo "let number = \"%{version:quiver}\"\n"))))

(rule
 (alias runtest)
 (action
  (run ./main.exe docs docs-site)))
