(library
 (name quiver_openssl)
 (public_name quiver.openssl)
 (libraries base base_bigstring unix)
 (foreign_stubs
  (language c)
  (names openssl_stubs ff1_stubs)
  (flags
   (:standard
    (:include c_flags.sexp))))
 (c_library_flags
  (:include c_library_flags.sexp)))

(rule
 (targets c_flags.sexp c_library_flags.sexp)
 (action
  (run
   %{exe:../config/discover.exe}
   -package
   openssl
   -fallback
   -lssl
   -fallback
   -lcrypto
   -link
   %{env:QUIVER_LINK=shared})))
