(library
 (name quiver_sink)
 (public_name quiver.sink)
 (libraries
  stdlib_stable
  base
  sexplib0
  yojson
  file_path
  core_unix
  portable
  quiver.core)
 (foreign_stubs
  (language c)
  (names float_stubs xxh3_stubs zstd_stubs)
  (flags
   (:standard
    -O3
    (:include c_flags.sexp)))
  (include_dirs ../../vendor/zmij ../../vendor/xxhash))
 (c_library_flags
  (:include c_library_flags.sexp))
 (foreign_archives ../../vendor/zmij/zmij)
 (preprocess
  (pps ppx_sexp_conv ppx_let ppx_string))
 (flags
  (:standard -open Stdlib_stable -open Sexplib0.Sexp_conv)))

(rule
 (targets c_flags.sexp c_library_flags.sexp)
 (action
  (run
   %{exe:../config/discover.exe}
   -package
   libzstd
   -fallback
   -lzstd
   -link
   %{env:QUIVER_LINK=shared})))
